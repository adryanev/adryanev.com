  "narrative": {
    "northStar": "Clear-line coding adventure",
    "overview": "The site uses ink outlines, warm paper, yellow and blue sheets, and Bricolage Grotesque type. Authored Blender scenes give the homepage workstation and Resume worktable a spatial role. Ordinary links, readable content, and keyboard controls remain available alongside them.\n\nThe content studio uses the same materials at a denser scale. Shared controls change height, border weight, and field background by context. Public chapter layouts and 3D controls keep their own composition while consuming the canonical tokens.",
    "keyCharacteristics": [
      "Paper and ink in light and dark themes",
      "Bricolage Grotesque with DM Mono metadata",
      "Shared controls with public and admin density",
      "Authored 3D with readable fallbacks"
    ],
    "rules": [
      {
        "name": "The role color rule",
        "body": "Use semantic foreground, surface, and feedback tokens for shared controls. Brand ink on a colored sheet is a different role from readable text on a dark page.",
        "section": "colors"
      },
      {
        "name": "The context rule",
        "body": "Use the shared component API for repeated controls. Keep route composition and authored 3D behavior in their domain components.",
        "section": "components"
      },
      {
        "name": "The printed depth rule",
        "body": "Keep hard offset color shadows on the established public sheets. Shared forms and studio panels use borders without adding a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do import shared controls from @/components/ui and reuse the canonical CSS tokens.",
      "Do keep ordinary links, keyboard access, visible focus, and reduced-motion behavior alongside 3D.",
      "Do give icon controls an accessible name and horizontal table regions a useful label.",
      "Do preserve factual project and role content."
    ],
    "donts": [
      "Don't restate brand colors, field styling, or control sizes in each route.",
      "Don't apply shared button dimensions to a domain control that intentionally uses the plain variant.",
      "Don't use color alone to convey validation or publication state.",
      "Don't invent testimonials, project results, or client endorsements."
    ]
  }
